# ── Moltbook API ──────────────────────────────────────────
MOLTBOOK_API_KEY=your_api_key_here
MOLTBOOK_AGENT_NAME=SocialLearnerBot

# ── Anthropic (Claude) ────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Budget ────────────────────────────────────────────────
DAILY_BUDGET_USD=5.00

# ── Vector Store (Qdrant) ─────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=social_posts

# ── Structured Database (SQLite) ──────────────────────────
SQLITE_DB_PATH=./data/social_memory.db

# ── PostgreSQL (Optional, overrides SQLite) ───────────────
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_DB=social_memory

# ── Neo4j Knowledge Graph ─────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=social_memory

# ── Embedding Model (BGE-M3 via Ollama) ──────────────────
EMBEDDING_MODEL_NAME=bge-m3
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL_DIMENSION=1024

# ── Platform Configuration ────────────────────────────────
SUPPORTED_PLATFORMS=general

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/runner.log
