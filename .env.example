# ── Moltbook API ──────────────────────────────────────────
MOLTBOOK_API_KEY=your_api_key_here
MOLTBOOK_AGENT_NAME=SocialLearnerBot

# ── LLM APIs ───────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
LLM_PRIMARY_PROVIDER=openai
LLM_FALLBACK_PROVIDER=anthropic
# Optional: force LLM traffic through proxy
# LLM_PROXY_URL=http://172.18.215.192:1080
# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# MOLTBOOK_VERIFIER_PROVIDER=openai
# MOLTBOOK_VERIFIER_OPENAI_MODEL=gpt-5.4
# MOLTBOOK_VERIFIER_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Budget ────────────────────────────────────────────────
DAILY_BUDGET_USD=5.00

# ── Vector Store (Qdrant) ─────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=social_posts

# ── Structured Database (SQLite) ──────────────────────────
SQLITE_DB_PATH=./data/social_memory.db

# ── PostgreSQL (Optional, overrides SQLite) ───────────────
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_DB=social_memory

# ── Neo4j Knowledge Graph ─────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=social_memory

# ── Embedding Model (Provider Switch: Ollama / SiliconFlow) ──
# Supported values: ollama | siliconflow
EMBEDDING_PROVIDER=ollama
# Ollama: bge-m3 ; SiliconFlow: BAAI/bge-m3
EMBEDDING_MODEL_NAME=bge-m3
# Ollama endpoint or SiliconFlow endpoint
EMBEDDING_API_URL=http://localhost:11434/api/embeddings
# Ollama usually does not need a key; SiliconFlow requires sk-xxxx
EMBEDDING_API_KEY=
EMBEDDING_MODEL_DIMENSION=1024

# ── Platform Configuration ────────────────────────────────
SUPPORTED_PLATFORMS=general

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/runner.log

# ── Server Deployment (docker-compose.server.yml) ─────────
# gost relay URL for the tunnel container
# GOST_FORWARD_URL=relay+tls://user:password@relay-host:8443
# Runner interval in minutes
# RUN_INTERVAL_MINUTES=30
# Optional image tag (default: latest)
# SOCIALITE_IMAGE_TAG=latest
# Optional global proxy (container outbound HTTP/HTTPS)
# HTTP_PROXY=http://172.18.215.192:1080
# HTTPS_PROXY=http://172.18.215.192:1080
# ALL_PROXY=http://172.18.215.192:1080
# NO_PROXY=localhost,127.0.0.1,gost-tunnel,qdrant-shared,postgres-db,neo4j-db
# no_proxy=localhost,127.0.0.1,gost-tunnel,qdrant-shared,postgres-db,neo4j-db

# Shared Docker infra hostnames (recommended on ai-infra network)
# QDRANT_HOST=qdrant-shared
# QDRANT_PORT=6333
# QDRANT_API_KEY=your_qdrant_api_key
# POSTGRES_HOST=postgres-db
# POSTGRES_PORT=5432
# POSTGRES_USER=user
# POSTGRES_PASSWORD=your_password_here
# POSTGRES_DB=social_memory
# NEO4J_URI=bolt://neo4j-db:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password
# NEO4J_DATABASE=neo4j
